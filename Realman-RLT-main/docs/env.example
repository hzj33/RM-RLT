# Example shell environment for Realman-RLT.
# Copy the relevant lines to ~/.bashrc or source this file manually.

# Project root.
export REALMAN_RLT_ROOT="$HOME/software/VLA/Realman-RLT"

# Hugging Face cache inside the repository.
export HF_HOME="$REALMAN_RLT_ROOT/.cache/huggingface"
export HF_DATASETS_CACHE="$HF_HOME/datasets"

# Enable these only when the base models are already cached locally.
# export HF_HUB_OFFLINE=1
# export TRANSFORMERS_OFFLINE=1

# RealMan RM_API2 Python SDK.
export RM_API2_PYTHON_PATH="$HOME/software/remote/RealMan/RM_API2/Python"
export RM_API_PATH="$RM_API2_PYTHON_PATH"

# Optional Quest / XRoboToolkit paths for RealMan data collection.
export XROBO_TOOLKIT_ROOT="$HOME/software/VLA/third_party"
export XROBO_PYBIND_ROOT="$XROBO_TOOLKIT_ROOT/XRoboToolkit-PC-Service-Pybind"
export XROBO_PC_SERVICE_ROOT="/opt/apps/roboticsservice"
export LD_LIBRARY_PATH="$XROBO_PYBIND_ROOT/lib:$XROBO_PC_SERVICE_ROOT/SDK/x64:$LD_LIBRARY_PATH"

# Optional ROS2 Humble.
# source /opt/ros/humble/setup.bash
